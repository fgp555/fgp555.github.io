# Copia este archivo a scripts/linkedin/.env y completa los valores reales.
# scripts/linkedin/.env está en .gitignore — nunca se sube al repo.

# De la app en https://www.linkedin.com/developers/apps (pestaña "Auth")
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=

# Estas dos las genera automáticamente get-token.js — no las llenes a mano
LINKEDIN_ACCESS_TOKEN=
LINKEDIN_PERSON_URN=
